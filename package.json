{
  "name": "@sledge-pdm/core",
  "version": "1.2.7",
  "private": false,
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "msgpackr": "^2.1.0",
    "pako": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/browser-playwright": "^4.0.16",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.9.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.16"
  },
  "scripts": {
    "dev": "",
    "build": "pnpm exec tsc -p tsconfig.build.json && pnpm exec tsc-alias -p tsconfig.build.json",
    "prettier": "prettier --write . --config .prettierrc",
    "format": "pnpm prettier",
    "test": "vitest run -c ./vitest.config.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  }
}
